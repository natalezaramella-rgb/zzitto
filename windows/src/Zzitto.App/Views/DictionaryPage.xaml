<Page
    x:Class="Zzitto.App.Views.DictionaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12" MaxWidth="720" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock x:Uid="DictionaryTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="?" HorizontalAlignment="Right" Click="OnHelpClick" />
        </Grid>
        <TextBlock Grid.Row="1" x:Uid="DictionaryIntro" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="WordBox" x:Uid="DictionaryWordBox" MinWidth="320" KeyDown="OnWordKeyDown" />
            <Button x:Uid="DictionaryAdd" Click="OnAddClick" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        <ListView Grid.Row="3" x:Name="WordsList" SelectionMode="Extended" MinHeight="200" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Button Grid.Row="4" x:Uid="DictionaryRemove" Click="OnRemoveClick" />
    </Grid>
</Page>
