<?xml version="1.0" encoding="utf-8"?>
<!-- Stato della prova e acquisto una tantum nel Microsoft Store (Spec §8.1, §8.2). Aggiunto il 22/10/2026 alle 11:32. -->
<Page
    x:Class="Zzitto.App.Views.LicensePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
        <Grid>
            <TextBlock x:Uid="LicenseTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="?" HorizontalAlignment="Right" Click="OnHelpClick" />
        </Grid>
        <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="BuyButton" x:Uid="LicenseBuy" Style="{StaticResource AccentButtonStyle}" Click="OnBuyClick" />
            <Button x:Name="RetryButton" x:Uid="LicenseRetry" Click="OnRetryClick" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" />
        </StackPanel>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
        <TextBlock x:Uid="LicensePrivacy" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
    </StackPanel>
</Page>
