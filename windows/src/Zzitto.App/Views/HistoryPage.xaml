<!-- Cronologia locale cifrata, disattivabile, cancellabile con un tocco (Spec §5.6, §10). Aggiunto il 22/10/2026 alle 11:32. -->
<Page
    x:Class="Zzitto.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12" MaxWidth="820" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock x:Uid="HistoryTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="?" HorizontalAlignment="Right" Click="OnHelpClick" />
        </Grid>
        <ToggleSwitch Grid.Row="1" x:Name="HistorySwitch" x:Uid="HistoryEnabled" Toggled="OnSettingsChanged" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <NumberBox x:Name="RetentionBox" x:Uid="HistoryRetention" Minimum="1" Maximum="365" SmallChange="1" LargeChange="7"
                       SpinButtonPlacementMode="Inline" Width="220" ValueChanged="OnRetentionChanged" />
            <Button x:Uid="HistoryClear" Click="OnClearClick" VerticalAlignment="Bottom" />
        </StackPanel>
        <ListView Grid.Row="3" x:Name="EntriesList" SelectionMode="Single" MinHeight="200" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" SelectionChanged="OnEntrySelected" />
        <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock x:Uid="HistoryRawLabel" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="RawText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
        <Button Grid.Row="5" x:Uid="HistoryCopy" Click="OnCopyClick" />
    </Grid>
</Page>
