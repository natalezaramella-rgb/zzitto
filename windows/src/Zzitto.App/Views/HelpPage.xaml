<?xml version="1.0" encoding="utf-8"?>
<!-- Guida all'uso (Spec §5.8): dettatura, comandi vocali, riscrittura, scorciatoie, fallback. Aggiunto il 22/10/2026 alle 11:32. -->
<Page
    x:Class="Zzitto.App.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Uid="HelpTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="HelpStartHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="StartText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Uid="HelpColorsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="HelpColorsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Uid="HelpCommandsHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="HelpCommandsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Uid="HelpRewriteHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="HelpRewriteText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Uid="HelpFallbackHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="HelpFallbackText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Uid="HelpPrivacyHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="HelpPrivacyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
