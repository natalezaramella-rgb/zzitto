<?xml version="1.0" encoding="utf-8"?>
<!-- Impostazioni generali (Spec §5.7, §2.4, §2.6, §4.2, §5.3, §5.9, §5.12). Aggiunto il 22/10/2026 alle 11:32. -->
<Page
    x:Class="Zzitto.App.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
            <Grid>
                <TextBlock x:Uid="GeneralTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <Button Content="?" HorizontalAlignment="Right" Click="OnHelpClick" />
            </Grid>

            <TextBlock x:Uid="GeneralDictationHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ComboBox x:Name="LanguageBox" x:Uid="GeneralLanguage" MinWidth="260" SelectionChanged="OnSettingChanged">
                <ComboBoxItem Tag="it" Content="Italiano" />
                <ComboBoxItem Tag="en" Content="English" />
                <ComboBoxItem Tag="es" Content="Español" />
                <ComboBoxItem Tag="fr" Content="Français" />
                <ComboBoxItem Tag="de" Content="Deutsch" />
            </ComboBox>
            <ComboBox x:Name="ModeBox" x:Uid="GeneralMode" MinWidth="260" SelectionChanged="OnSettingChanged">
                <ComboBoxItem x:Uid="ModeFaithfulItem" Tag="Faithful" />
                <ComboBoxItem x:Uid="ModeCleanItem" Tag="Clean" />
                <ComboBoxItem x:Uid="ModeFormalItem" Tag="Formal" />
            </ComboBox>
            <ComboBox x:Name="TranslateBox" x:Uid="GeneralTranslate" MinWidth="260" SelectionChanged="OnSettingChanged">
                <ComboBoxItem x:Uid="TranslateNoneItem" Tag="None" />
                <ComboBoxItem x:Uid="TranslateEnglishItem" Tag="English" />
                <ComboBoxItem x:Uid="TranslateSpanishItem" Tag="Spanish" />
            </ComboBox>
            <NumberBox x:Name="SilenceBox" x:Uid="GeneralSilence" Minimum="0.5" Maximum="10" SmallChange="0.5" LargeChange="1"
                       SpinButtonPlacementMode="Inline" MaxWidth="260" HorizontalAlignment="Left" ValueChanged="OnNumberChanged" />
            <NumberBox x:Name="MaxDurationBox" x:Uid="GeneralMaxDuration" Minimum="1" Maximum="15" SmallChange="1" LargeChange="5"
                       SpinButtonPlacementMode="Inline" MaxWidth="260" HorizontalAlignment="Left" ValueChanged="OnNumberChanged" />
            <ToggleSwitch x:Name="VoiceCommandsSwitch" x:Uid="GeneralVoiceCommands" Toggled="OnToggled" />
            <ToggleSwitch x:Name="StartSoundSwitch" x:Uid="GeneralStartSound" Toggled="OnToggled" />
            <ToggleSwitch x:Name="ClipboardSelectionSwitch" x:Uid="GeneralClipboardSelection" Toggled="OnToggled" />

            <TextBlock x:Uid="GeneralAppHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Uid="GeneralHotkeyLabel" VerticalAlignment="Center" />
                <Button x:Name="HotkeyButton" MinWidth="200" Click="OnHotkeyClick" PreviewKeyDown="OnHotkeyKeyDown" LostFocus="OnHotkeyLostFocus" />
            </StackPanel>
            <TextBlock x:Name="HotkeyStatus" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <ToggleSwitch x:Name="StartupSwitch" x:Uid="GeneralStartup" Toggled="OnStartupToggled" />
            <ComboBox x:Name="OverlayModeBox" x:Uid="GeneralOverlayMode" MinWidth="260" SelectionChanged="OnSettingChanged">
                <ComboBoxItem x:Uid="OverlayFollowItem" Tag="FollowField" />
                <ComboBoxItem x:Uid="OverlayFixedItem" Tag="FixedPosition" />
                <ComboBoxItem x:Uid="OverlayHiddenItem" Tag="Hidden" />
            </ComboBox>
            <NumberBox x:Name="UnloadBox" x:Uid="GeneralUnload" Minimum="1" Maximum="120" SmallChange="1" LargeChange="5"
                       SpinButtonPlacementMode="Inline" MaxWidth="260" HorizontalAlignment="Left" ValueChanged="OnNumberChanged" />
            <ToggleSwitch x:Name="GpuSwitch" x:Uid="GeneralGpu" Toggled="OnToggled" />
            <TextBlock x:Uid="GeneralGpuNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            <Button x:Uid="GeneralRepeatTour" Click="OnRepeatTourClick" />

            <TextBlock x:Uid="GeneralPrivacyHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Uid="GeneralPrivacyText" TextWrapping="Wrap" />
            <TextBlock x:Name="EngineStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
