<?xml version="1.0" encoding="utf-8"?>
<!-- Licenze open source (Spec §2.2): testo di THIRD_PARTY_LICENSES.md incluso nel pacchetto. Aggiunto il 22/10/2026 alle 11:32. -->
<Page
    x:Class="Zzitto.App.Views.OpenSourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock x:Uid="OpenSourceTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="?" HorizontalAlignment="Right" Click="OnHelpClick" />
        </Grid>
        <TextBlock Grid.Row="1" x:Uid="OpenSourceIntro" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="12">
            <TextBlock x:Name="LicensesText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
        </ScrollViewer>
    </Grid>
</Page>
