<Page
    x:Class="Zzitto.App.Views.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12" MaxWidth="720" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock x:Uid="ShortcutsTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="?" HorizontalAlignment="Right" Click="OnHelpClick" />
        </Grid>
        <TextBlock Grid.Row="1" x:Uid="ShortcutsIntro" TextWrapping="Wrap" />
        <TextBox Grid.Row="2" x:Name="KeywordBox" x:Uid="ShortcutsKeywordBox" MaxWidth="320" HorizontalAlignment="Left" />
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBox x:Name="ExpansionBox" x:Uid="ShortcutsExpansionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
            <Button x:Uid="ShortcutsAdd" Click="OnAddClick" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        <ListView Grid.Row="4" x:Name="ShortcutsList" SelectionMode="Extended" MinHeight="160" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Button Grid.Row="5" x:Uid="ShortcutsRemove" Click="OnRemoveClick" />
    </Grid>
</Page>
