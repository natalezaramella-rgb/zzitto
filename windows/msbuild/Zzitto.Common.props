<!--
  Impostazioni comuni ai progetti Windows dell'agente C (Spec §2.4, §4.3, §11.1).
  Aggiunto il 22/10/2026 alle 11:32.
  Importato esplicitamente (non è un Directory.Build.props) per non toccare i progetti
  Zzitto.Core (orchestratore) e Zzitto.Licensing (agente D).
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Spec §2.4: Windows 11; 19041 come minimo evita gli avvisi CA1416 sulle API WinRT. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Spec §11.1: compilazione nativa ARM64 e x64. -->
    <Platforms>x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Gli avvisi di vulnerabilità NuGet restano avvisi: vanno valutati (Spec §10), non bloccano la build offline. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
    <Company>Zaramella Consulting Srl</Company>
    <Product>Zzitto</Product>
    <Copyright>© 2026 Zaramella Consulting Srl</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>
</Project>
