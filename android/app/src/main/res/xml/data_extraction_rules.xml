<?xml version="1.0" encoding="utf-8"?>
<!-- Spec §10: cronologia, dizionario e impostazioni non escono dal dispositivo, nemmeno col backup. Aggiunto il 22/10/2026 alle 11:59. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
